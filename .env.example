# ---- Chat model providers ----------------------------------------------------
# Add a key for each provider you want to use. Providers without a key are skipped.
GEMINI_API_KEY=your_actual_api_key_here
# GROQ_API_KEY=        # free key: https://console.groq.com/keys
# OPENROUTER_API_KEY=  # free key: https://openrouter.ai/settings/keys

# Providers to try in order, as provider:model (leave the model out for the default).
# When one is rate-limited, out of quota or down, the next one answers.
# Default without LLM_CHAIN: gemini:$GEMINI_MODEL then gemini:$GEMINI_FALLBACK_MODEL.
# LLM_CHAIN=gemini:gemini-3.5-flash,groq:openai/gpt-oss-120b,openrouter:openrouter/free,gemini:gemini-flash-lite-latest
# Check which entries work (including tool calling): python -m llm.check

# Optional: Gemini models used when LLM_CHAIN is not set
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Optional: Ollama runs models on your own machine (https://ollama.com). Use e.g. ollama:qwen3:4b in LLM_CHAIN.
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ---- Search ---------------------------------------------------------------------
# Optional: embedding model for search (default: intfloat/multilingual-e5-large, runs locally,
# no quota). Use gemini-embedding-001 for the Gemini API instead. Rebuild the index after
# changing it: python -m rag.ingest
# EMBEDDING_MODEL=intfloat/multilingual-e5-large

# Optional: set to 1 to enable Flask debug mode locally
# FLASK_DEBUG=1
